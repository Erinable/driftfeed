# Copy to .env and fill in. driftfeed reads these from the process environment;
# nothing is ever written back to the repository or the database.

# --- Reddit (OAuth2 client credentials / installed-app flow) ---
# Create an app at https://www.reddit.com/prefs/apps (type: "script" or "installed app").
DRIFTFEED_REDDIT_CLIENT_ID=
DRIFTFEED_REDDIT_CLIENT_SECRET=
# Optional: only needed for the "password" grant on a script app.
DRIFTFEED_REDDIT_USERNAME=
DRIFTFEED_REDDIT_PASSWORD=

# --- GitHub ---
# Any token with public read scope. GITHUB_TOKEN is also honoured, and so is
# `gh auth token` when the GitHub CLI is installed and logged in.
GITHUB_TOKEN=

# --- Paths / behaviour ---
# Override the data directory (default: platform app-data dir, e.g. ~/.local/share/driftfeed)
# DRIFTFEED_HOME=/path/to/dir
# Override the sqlite file directly.
# DRIFTFEED_DB=/path/to/driftfeed.sqlite3
# Embedding backend: "hashing" (default, no downloads) or "sentence-transformers"
# DRIFTFEED_EMBEDDER=hashing
# DRIFTFEED_ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Contact string appended to the outgoing User-Agent (good netizen practice).
# DRIFTFEED_USER_AGENT_CONTACT=you@example.com
